#include <stdio.h>

int main() {
    int M[3][4];
    int somaLinhas[3] = {0, 0, 0}; 
    int somaTotal = 0;
    int i, j;

    for(i = 0; i < 3; i++) {
        for(j = 0; j < 4; j++) {
            printf("Digite M[%d][%d]: ", i, j);
            scanf("%d", &M[i][j]);
        }
    }

    for(i = 0; i < 3; i++) {
        for(j = 0; j < 4; j++) {
            somaLinhas[i] += M[i][j];
        }
        somaTotal += somaLinhas[i];
    }

    for(i = 0; i < 3; i++) {
        printf("Soma da Linha %d: %d\n", i, somaLinhas[i]);
    }

    printf("\nSoma total de todos os elementos: %d\n", somaTotal);

    return 0;
}

